# ============================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# ============================================

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=your_dev_root_password
MYSQL_DATABASE=talentix_dev
MYSQL_USER=talentix
MYSQL_PASSWORD=your_dev_db_password

# Docker Registry Configuration
DOCKER_REGISTRY=ghcr.io
GITHUB_USERNAME=issach315
IMAGE_TAG=dev-latest

# Application Configuration
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081

# JVM Options
JAVA_OPTS=-Xmx512m -Xms256m

# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================

# Production MySQL (use different values)
# MYSQL_ROOT_PASSWORD=your_secure_prod_root_password
# MYSQL_DATABASE=talentix_prod
# MYSQL_USER=talentix_prod
# MYSQL_PASSWORD=your_secure_prod_password

# Production Image Tag
# IMAGE_TAG=prod-latest
# SPRING_PROFILES_ACTIVE=prod
# SERVER_PORT=8080

# ============================================
# SERVER DEPLOYMENT CONFIGURATION
# ============================================

# Development Server (Update with your server details)
# DEV_SERVER_HOST=your-dev-server.com
# DEV_SERVER_USER=deployer
# DEV_SERVER_PORT=22

# Production Server (Update with your server details)
# PROD_SERVER_HOST=your-prod-server.com
# PROD_SERVER_USER=deployer
# PROD_SERVER_PORT=22